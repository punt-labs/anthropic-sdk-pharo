# Pharo VM and image
pharo/

# Runtime state (port-specific: .pharo-8422.pid, .pharo-8423.pid, etc.)
.pharo-*.pid
.pharo-*.log
.tmp/

# Pharo debug logs
PharoDebug.log

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz

# macOS
.DS_Store

.biff.local

# Machine-specific direnv overrides — may hold secrets, never committed
.envrc.local

# Claude Code scheduler runtime lock (machine-local, transient)
.claude/scheduled_tasks.lock

# Stray beads embedded-dolt dir created in the wrong place;
# the real beads config is the top-level .beads/ (server mode)
aspharo/

# Quarry session-transcript captures (pkit-kcps)
.punt-labs/quarry/captures/
