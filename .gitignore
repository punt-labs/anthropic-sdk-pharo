# Pharo VM and image
pharo/

# Runtime state (port-specific: .pharo-8422.pid, .pharo-8423.pid, etc.)
.pharo-*.pid
.pharo-*.log
.tmp/

# Pharo debug logs
PharoDebug.log

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz

# macOS
.DS_Store

.biff.local

# Machine-specific direnv overrides — may hold secrets, never committed
.envrc.local

# Claude Code scheduler runtime lock (machine-local, transient)
.claude/scheduled_tasks.lock

# Retired beads tracker state (Linear is the tracker of record) and
# the stray embedded-dolt dir it once created
.beads/
aspharo/

# Quarry session-transcript captures (pkit-kcps)
.punt-labs/quarry/captures/

# Claude Code local settings (per-machine, may contain paths/tokens)
.claude/settings.local.json

# Sibling lock every punt CLI takes before mutating a shared host file (persists by design)
.*.lock

# ethos local zone (runtime state, never committed)
.punt-labs/**/local/**
.punt-labs/**/*.local.*
.punt-labs/ethos/sessions/
.punt-labs/ethos/missions/
.punt-labs/ethos/missions.jsonl*
.punt-labs/**/*.ethos-tmp*

# ethos: shared machine-local zone (never track)
.punt-labs/local/
